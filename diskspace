#!/usr/bin/env bash
# USAGE: 
# DESC: Visual Storage Breakdown of home directories
echo -e "\033[1;36mScanning Home Directory Storage...\033[0m"
echo "------------------------------------------------------"

# Core user directories to check
TARGETS=("$HOME/Downloads" "$HOME/.cache" "$HOME/.local" "$HOME/Documents" "$HOME/Pictures" "$HOME/Videos" "$HOME/Music" "$HOME/Desktop")

VALID_TARGETS=()
for t in "${TARGETS[@]}"; do
    if [ -d "$t" ]; then
        VALID_TARGETS+=("$t")
    fi
done

# 'du -sm' gets sizes in Megabytes.
# awk processes the sizes, handles GB conversions, and generates the bar chart.
du -sm "${VALID_TARGETS[@]}" 2>/dev/null | sort -nr | awk -v home="$HOME" '
BEGIN { max = 0 }
{
    size_mb = $1;
    path = $2;
    sub(home, "~", path); # Replace absolute home path with ~ for readability
    
    sizes[NR] = size_mb;
    paths[NR] = path;
    
    if (size_mb > max) { max = size_mb }
}
END {
    for (i = 1; i <= NR; i++) {
        if (sizes[i] == 0) continue;
        
        # Format Size (GB or MB)
        if (sizes[i] >= 1024) {
            display_size = sprintf("%.1f GB", sizes[i]/1024);
        } else {
            display_size = sizes[i] " MB";
        }
        
        # Build graphical bar (max length of 25 blocks)
        bar_len = int((sizes[i] / max) * 25);
        if (bar_len == 0 && sizes[i] > 0) bar_len = 1;
        
        bar = "";
        for (b = 0; b < bar_len; b++) { bar = bar "▇"; }
        
        printf "\033[1;32m%-9s\033[0m %-18s \033[1;33m%s\033[0m\n", display_size, paths[i], bar;
    }
}'
echo "------------------------------------------------------"
