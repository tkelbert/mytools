#!/bin/bash
# USAGE: 
# DESC: 10-category network triage & info

# --- Color Definitions ---
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
NC='\033[0m'

# --- Usage Guard ---
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo -e "${YELLOW}Usage: netinfo${NC}"
    echo -e "Displays a comprehensive overview of current network status."
    exit 0
fi

print_header() {
    echo -e "\n${CYAN}=== $1 ===${NC}"
}

print_header "1. Hostname Information"
echo -e "${YELLOW}Hostname:${NC} $(hostname)"
echo -e "${YELLOW}Kernel:${NC}   $(uname -r)"

print_header "2. Public IP Address"
PUB_IP=$(curl -sS --max-time 2 https://api.ipify.org 2>/dev/null)
if [[ -n "$PUB_IP" ]]; then
    echo -e "${GREEN}${PUB_IP}${NC}"
else
    echo -e "${RED}Offline or unreachable${NC}"
fi

print_header "3. Local IP Addresses"
ip -brief addr show | awk -v green="${GREEN}" -v nc="${NC}" '{
    if ($1 != "lo") {
        printf "%-15s " green "%-30s" nc "\n", $1, $3
    }
}'

print_header "4. Interfaces & MAC Addresses"
ip -brief link show | awk -v yellow="${YELLOW}" -v green="${GREEN}" -v red="${RED}" -v nc="${NC}" '{
    state_color = ($2 == "UP" || $2 == "UNKNOWN") ? green : red;
    printf "%-15s " state_color "%-10s" nc yellow "%s" nc "\n", $1, $2, $3;
}'

print_header "5. Default Gateway"
ip route show default 2>/dev/null | awk -v green="${GREEN}" -v nc="${NC}" '{print "Gateway: " green $3 nc " (via " $5 ")"}'

print_header "6. DNS Servers"
if command -v resolvectl &> /dev/null; then
    resolvectl dns 2>/dev/null | grep -v '^-' | sed 's/^[ \t]*//' | grep -v '^$' | awk -v yellow="${YELLOW}" -v nc="${NC}" '{print yellow $0 nc}'
else
    grep "^nameserver" /etc/resolv.conf | awk -v yellow="${YELLOW}" -v nc="${NC}" '{print yellow $2 nc}'
fi

if command -v nmcli &> /dev/null; then
    WIFI=$(nmcli -t -f active,ssid,signal dev wifi 2>/dev/null | grep '^yes')
    if [[ -n "$WIFI" ]]; then
        print_header "7. Active Wi-Fi Connection"
        SSID=$(echo "$WIFI" | cut -d':' -f2)
        SIGNAL=$(echo "$WIFI" | cut -d':' -f3)
        echo -e "${YELLOW}SSID:${NC}   $SSID"
        echo -e "${YELLOW}Signal:${NC} ${GREEN}${SIGNAL}%${NC}"
    fi
fi

print_header "8. Active IPv4 Routes"
ip -4 route show | grep -v default | awk -v nc="${NC}" -v y="${YELLOW}" '{print y $1 nc " -> " $3}' | sed "s/^/  /"

print_header "9. Open Listening Ports"
echo -e "${YELLOW}Total Active Listening Sockets:${NC} $(ss -tuln 2>/dev/null | tail -n +2 | wc -l)"
PORTS=$(ss -tuln 2>/dev/null | tail -n +2 | awk '{print $5}' | rev | cut -d':' -f1 | rev | sort -nu | xargs)
echo -e "  Ports: ${GREEN}${PORTS}${NC}"

print_header "10. Traffic Statistics (Total MBs)"
cat /proc/net/dev | tail -n +3 | awk -v yellow="${YELLOW}" -v nc="${NC}" -v green="${GREEN}" '{
    rx = $2 / 1048576;
    tx = $10 / 1048576;
    if (rx > 0 || tx > 0) {
        gsub(":", "", $1);
        printf "%-15s RX: " green "%8.2f MB" nc "  TX: " yellow "%8.2f MB" nc "\n", $1, rx, tx;
    }
}'

echo ""
