#!/usr/bin/env bash
# USAGE: 
# DESC: Display this cheat sheet

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
NC='\033[0m'

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo -e "${YELLOW}Usage: mytools${NC}"
    echo -e "Dynamically generates a cheat sheet of all executable scripts in /opt/custom-toolkit"
    exit 0
fi

echo "======================================================================"
echo -e " ${CYAN}🛠️  YOUR CUSTOM TERMINAL TOOLKIT (/opt/custom-toolkit)${NC}"
echo "======================================================================"

cd /opt/custom-toolkit || exit 1

for file in $(ls -1 | sort); do
    [[ -f "$file" && -x "$file" ]] || continue

    cmd="$file"
    parsed_usage=""
    parsed_desc=""

    # Pull the tags from the top 20 lines
    while IFS= read -r line; do
        if [[ "$line" == "# USAGE: "* ]]; then
            parsed_usage="${line#*# USAGE: }"
        elif [[ "$line" == "# DESC: "* ]]; then
            parsed_desc="${line#*# DESC: }"
        fi
    done < <(head -n 20 "$file" 2>/dev/null)

    # Apply fallbacks if tags are missing
    usage="$parsed_usage"
    desc="${parsed_desc:-Custom script (Add '# DESC: <description>' to file to label)}"

    printf "  ${GREEN}%-12s${NC} ${YELLOW}%-25s${NC} - %s\n" "$cmd" "$usage" "$desc"
done

echo "======================================================================"
