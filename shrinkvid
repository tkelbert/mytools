#!/usr/bin/env bash
# USAGE: [file]
# DESC: Compress video to 720p H.264

input="$1"

# If no file specified, find newest video in ~/Videos or ~/Downloads
if [[ -z "$input" ]]; then
    input=$(find "$HOME/Videos" "$HOME/Downloads" -maxdepth 1 -type f \
        \( -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.mov" -o -iname "*.webm" \) \
        ! -name "*_shrunk.mp4" -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -n 1 | cut -d' ' -f2-)
    if [[ -z "$input" ]]; then
        echo "Usage: shrinkvid <video_file> (No recent video found automatically)"
        exit 1
    fi
    echo "Auto-selected latest video: $input"
fi

base="${input%.*}"
output="${base}_shrunk.mp4"

orig_size=$(du -h "$input" | cut -f1)
echo "Compressing '$input' ($orig_size)..."

ffmpeg -hide_banner -loglevel warning -stats -i "$input" \
    -vf "scale='min(1280,iw)':-2" -c:v libx264 -crf 26 -preset fast \
    -c:a aac -b:a 128k "$output"

if [[ $? -eq 0 ]]; then
    new_size=$(du -h "$output" | cut -f1)
    echo "Done! Shrunk from $orig_size -> $new_size"
    echo "Saved to: $output"
fi
