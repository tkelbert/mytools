#!/usr/bin/env bash
# USAGE: <file> [expected_hash]
# DESC: Instant Checksum & Verification Generator
if [[ -z "$1" ]]; then
    echo -e "\033[1;33mUsage:\033[0m hashme <file> [expected_hash]"
    exit 1
fi

FILE="$1"
EXPECTED="$2"

if [[ ! -f "$FILE" ]]; then
    echo -e "\033[1;31m[ERROR]\033[0m File not found: $FILE"
    exit 1
fi

echo -e "Computing hashes for \033[1;36m$FILE\033[0m..."
MD5=$(md5sum "$FILE" | awk '{print $1}')
SHA1=$(sha1sum "$FILE" | awk '{print $1}')
SHA256=$(sha256sum "$FILE" | awk '{print $1}')

echo "------------------------------------------------------"
echo -e "\033[1;34mMD5:\033[0m    $MD5"
echo -e "\033[1;34mSHA1:\033[0m   $SHA1"
echo -e "\033[1;34mSHA256:\033[0m $SHA256"
echo "------------------------------------------------------"

if [[ -n "$EXPECTED" ]]; then
    if [[ "$EXPECTED" == "$MD5" ]] || [[ "$EXPECTED" == "$SHA1" ]] || [[ "$EXPECTED" == "$SHA256" ]]; then
        echo -e "\033[1;32m[MATCH]\033[0m The provided hash securely matches a generated checksum!"
    else
        echo -e "\033[1;31m[MISMATCH]\033[0m The provided hash does NOT match any computed checksum."
    fi
fi
