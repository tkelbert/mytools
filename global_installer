#!/usr/bin/env bash

# --- Color Definitions ---
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
RED='\033[1;31m'
NC='\033[0m'

echo -e "${CYAN}=== Global Toolkit Installer ===${NC}"

# Ensure git is installed
if ! command -v git &> /dev/null; then
    echo -e "${YELLOW}Installing git...${NC}"
    sudo apt update && sudo apt install -y git
fi

# 1. Get the repository URL
# Based on your image, your username is tkelbert, so the URL should look like https://github.com/tkelbert/YOUR-REPO-NAME.git
echo -e "\n${YELLOW}Enter your full GitHub repository URL (HTTPS or SSH):${NC}"
read -r -p "> " REPO_URL

if [[ -z "$REPO_URL" ]]; then
    echo -e "${RED}Error: No URL provided. Aborting.${NC}"
    exit 1
fi

# 2. Clone the repository globally
echo -e "\n${CYAN}Cloning to /opt/custom-toolkit...${NC}"
sudo rm -rf /opt/custom-toolkit
if ! sudo git clone "$REPO_URL" /opt/custom-toolkit; then
    echo -e "${RED}Failed to clone. Check your URL or internet connection.${NC}"
    exit 1
fi

# 3. Apply global 777 permissions so any user can execute and edit
echo -e "${CYAN}Setting global permissions...${NC}"
sudo chmod -R 777 /opt/custom-toolkit

# 4. Inject into the system-wide PATH for all terminal sessions
echo -e "${CYAN}Configuring system PATH...${NC}"
if ! grep -q "/opt/custom-toolkit" /etc/bash.bashrc; then
    echo 'export PATH="/opt/custom-toolkit:$PATH"' | sudo tee -a /etc/bash.bashrc > /dev/null
fi

echo 'export PATH="/opt/custom-toolkit:$PATH"' | sudo tee /etc/profile.d/custom-toolkit.sh > /dev/null

echo -e "\n${GREEN}✓ Toolkit successfully installed globally!${NC}"
echo -e "Apply the changes to your current terminal by running:"
echo -e "  export PATH=\"/opt/custom-toolkit:\$PATH\""
echo -e "Then type ${YELLOW}mytools${NC} to see your tools."
