#!/usr/bin/env bash
# USAGE: 
# DESC: Instant CLI OCR using maim and tesseract
# Verifies dependencies
if ! command -v tesseract &> /dev/null || ! command -v xclip &> /dev/null; then
    echo -e "\033[1;31m[ERROR]\033[0m Missing dependencies. Please install:"
    echo -e "  sudo apt install tesseract-ocr xclip maim"
    exit 1
fi

TMP_IMG="/tmp/ocr_capture.png"
rm -f "$TMP_IMG"

echo -e "\033[1;36m[OCR]\033[0m Drag a box over the text to extract..."

# Uses maim for screenshotting (fast, lightweight, standard on modern distros)
if command -v maim &> /dev/null; then
    maim -s "$TMP_IMG"
elif command -v gnome-screenshot &> /dev/null; then
    gnome-screenshot -a -f "$TMP_IMG"
else
    echo -e "\033[1;31m[ERROR]\033[0m Please install 'maim' for region selection."
    exit 1
fi

if [[ ! -f "$TMP_IMG" ]]; then
    echo -e "\033[1;31m[ERROR]\033[0m Capture cancelled or failed."
    exit 1
fi

echo -e "\033[1;36m[OCR]\033[0m Processing image..."
# Run tesseract, sending output to stdout, suppress logging, trim trailing spaces
TEXT=$(tesseract "$TMP_IMG" stdout -l eng --psm 6 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

if [[ -n "$TEXT" ]]; then
    echo "$TEXT" | xclip -selection clipboard
    echo "------------------------------------------------------"
    echo -e "$TEXT"
    echo "------------------------------------------------------"
    echo -e "\033[1;32m[SUCCESS]\033[0m Text copied to your clipboard!"
else
    echo -e "\033[1;33m[WARNING]\033[0m No text could be identified in that region."
fi
